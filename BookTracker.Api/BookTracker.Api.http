@BookTracker.Api_HostAddress = http://localhost:5089

GET {{BookTracker.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

### Create Book
POST http://localhost:5089/books
Content-Type: application/json

{
  "title": "Dune",
  "author": "Frank Herbert",
  "year": 1965
}
###

GET {{BookTracker.Api_HostAddress}}/books

### Delete existing book
DELETE {{BookTracker.Api_HostAddress}}/books/1

###

### Delete non-existing book
DELETE {{BookTracker.Api_HostAddress}}/books/9999

###

### Update Book
PUT http://localhost:5089/books/1
Content-Type: application/json

{
  "title": "Changes",
  "author": "David Bowie",
  "year": 1971
}

###

PUT http://localhost:5089/books/9999
Content-Type: application/json

{
  "title": "Unknown Book",
  "author": "Unknown Author",
  "year": 2000
}

###

### Get Book by Id
GET http://localhost:5089/books/1
GET http://localhost:5089/books/9999