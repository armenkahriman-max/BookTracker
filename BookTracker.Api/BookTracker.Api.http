GET http://localhost:5089/books

###

# Create Book
POST http://localhost:5089/books
Content-Type: application/json

{
   "title": "Octopus Garden",
  "author": "The Beatles",
  "year": 1966
}

###

# Delete Book
DELETE http://localhost:5089/books/2

###

DELETE http://localhost:5089/books/9999

###

# Update Book
PUT http://localhost:5089/books/3
Content-Type: application/json

{
  "title": "Changes",
  "author": "David Bowie",
  "year": 1971
}

###

PUT http://localhost:5089/books/9999
Content-Type: application/json

{
  "title": "Unknown Book",
  "author": "Unknown Author",
  "year": 2000
}

###

# Get Book by Id
GET http://localhost:5089/books/3

###

GET http://localhost:5089/books/9999

### Get Books Page 1
GET http://localhost:5089/books?page=1&pageSize=10

### Get Books Page 2
GET http://localhost:5089/books?page=2&pageSize=10

### Search Books
GET http://localhost:5089/books?search=octopus

### Search Books With Paging
GET http://localhost:5089/books?search=octopus&page=1&pageSize=1

### Get Members
GET http://localhost:5089/members

### Create Member
POST http://localhost:5089/members
Content-Type: application/json

{
  "name": "Ada Lovelace",
  "email": "ada@example.com"
}

### Get Member Details
GET http://localhost:5089/members/7

### Update Member
PUT http://localhost:5089/members/7
Content-Type: application/json

{
  "name": "Ada Byron",
  "email": "ada.byron@example.com"
}

### Delete Member
DELETE http://localhost:5089/members/7