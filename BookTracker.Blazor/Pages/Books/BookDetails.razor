@page "/books/{Id:int}"
@using BookTracker.Blazor.Models.Books
@using BookTracker.Blazor.Api
@using Microsoft.AspNetCore.Components.Authorization

@inject BookTrackerClient BookTrackerClient
@inject NavigationManager NavigationManager

<PageTitle>@(book?.Title ?? "BookDetails")</PageTitle>

    @if (loading)
{
    <p>Book loading...</p>
}
else if (error)
{
    <div class="alert alert-danger">There was an error while loading the book.</div>
    <button class="btn btn-secondary" @onclick="GoBack">Return to list</button>
}
else if (book is null)
{
    <p>@(alreadyDeleted
    ? "This book may already have been deleted."
    : "Book not found")
    </p>
    <button class="btn btn-secondary" @onclick="GoBack">Return to list</button>
}
else
{
    <h1>@book.Title</h1>
    <p><strong>Author:</strong> @book.Author</p>
    <p><strong>Year:</strong> @book.Year</p>

    <button class="btn btn-secondary" @onclick="GoBack">Back to list</button>

    <AuthorizeView Roles="Administrator">
        @if (confirmingDelete)
        {
            <p>Really delete "@book.Title"?</p>
            <button class="btn btn-secondary" disabled="@isDeleting" @onclick="ConfirmDeleteAsync">Confirm</button>
            <button class="btn btn-secondary" disabled="@isDeleting" @onclick="CancelDelete">Cancel</button>
        }
        else
        {
            <a href="/books/@Id/edit">Edit</a>
            <button class="btn btn-danger" @onclick="AskDelete">Delete</button>
        }

    </AuthorizeView>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private BookDetailsResponse? book;
    private bool loading;
    private bool error;
    private bool confirmingDelete;
    private bool isDeleting;
    private bool alreadyDeleted;

    protected override async Task OnParametersSetAsync()
    {
        await LoadBookAsync();
    }

    private async Task LoadBookAsync()
    {
        loading = true;
        error = false;
        book = null;
        alreadyDeleted = false;

        try
        {
            book = await BookTrackerClient.GetBookDetails(Id);
        }
        catch
        {
            error = true;
            book = null;
        }
        finally
        {
            loading = false;
        }
    }
    private async Task ConfirmDeleteAsync()
    {
        if (isDeleting)
            return;
        isDeleting = true;

        var result = await BookTrackerClient.DeleteBookAsync(Id);

        switch (result.Status)
        {
            case DeleteBookStatus.NoContent:
                NavigationManager.NavigateTo("/");
                break;
            case DeleteBookStatus.NotFound:
                alreadyDeleted = true; book = null; isDeleting = false;
                break;
            case DeleteBookStatus.Unauthorized:
            case DeleteBookStatus.Forbidden:
                isDeleting = false;
                break;
            default:
                isDeleting = false;
                break;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }
    private void AskDelete()
    {
        confirmingDelete = true;
    }
    private void CancelDelete()
    {
        confirmingDelete = false;
    }
}