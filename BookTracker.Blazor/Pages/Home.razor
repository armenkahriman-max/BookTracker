@page "/"
@using BookTracker.Blazor.Models.Books
@using BookTracker.Blazor.Api
@using BookTracker.Blazor.Components.Books
@inject BookTrackerClient BookTrackerClient
@inject NavigationManager NavigationManager


<PageTitle>Book Tracker</PageTitle>

<h1>Book Tracker</h1>

<button @onclick="ToggleAuthors">
    @(showAuthors ? "Hide author" : "Show author")
</button>

<div class="mb-3">
    <input class="form-control" @bind="search" @bind:event="oninput" placeholder="Zoek op titel of auteur..." />
    <button class="btn btn-primary mt-2" @onclick="SearchAsync">Zoeken</button>
</div>

@if (loading)
{
    <p>Boeken laden...</p>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (result is null || result.Items.Count == 0)
{
    <p>Geen boeken gevonden.</p>
}
else
{
    @foreach (var book in result.Items)
    {
        <BookSummaryCard Book="book" ShowAuthor="showAuthors" OnSelected="SelectBook" />
    }

    <div class="d-flex align-items-center gap-3 mt-3">
        <button class="btn btn-secondary" disabled="@(currentPage <= 1)" @onclick="PreviousPageAsync">
            Vorige
        </button>

        <span>Pagina @result.Page van @result.TotalPages</span>

        <button class="btn btn-secondary" disabled="@(currentPage >= result.TotalPages)" @onclick="NextPageAsync">
            Volgende
        </button>
    </div>
}

@code {
    private GetBookSummariesResponse? result;
    private bool loading;
    private string? error;
    private string search = string.Empty;
    private int currentPage = 1;
    private const int PageSize = 10;

    private bool showAuthors = true;
    

    protected override async Task OnInitializedAsync()
    {
        await LoadBooksAsync();
    }

    private async Task LoadBooksAsync()
    {
        loading = true;
        error = null;

        try
        {
            result = await BookTrackerClient.GetBooks(
                string.IsNullOrWhiteSpace(search) ? null : search,
                currentPage,
                PageSize);
        }
        catch
        {
            error = "There was an error while loading the book.";
            result = null;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadBooksAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadBooksAsync();
        }
    }

    private async Task NextPageAsync()
    {
        if (result is not null && currentPage < result.TotalPages)
        {
            currentPage++;
            await LoadBooksAsync();
        }
    }

    private void ToggleAuthors()
    {
        showAuthors = !showAuthors;
    }

    private void SelectBook(int bookId)
    {
        NavigationManager.NavigateTo($"/books/{bookId}");
    }
}